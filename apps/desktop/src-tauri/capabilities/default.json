{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only Quarry's own commands plus core event/window basics.",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "allow-settings-get",
    "allow-settings-set",
    "allow-workspace-get",
    "allow-workspace-set",
    "allow-connections-list",
    "allow-connection-create",
    "allow-connection-update",
    "allow-connection-duplicate",
    "allow-connection-delete",
    "allow-connection-test",
    "allow-connection-connect",
    "allow-connection-disconnect",
    "allow-sessions-list"
  ]
}
