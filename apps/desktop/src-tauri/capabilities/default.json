{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only Quarry's own commands plus core event/window basics.",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "allow-settings-get",
    "allow-settings-set",
    "allow-workspace-get",
    "allow-workspace-set",
    "allow-connections-list",
    "allow-connection-create",
    "allow-connection-update",
    "allow-connection-duplicate",
    "allow-connection-delete",
    "allow-connection-test",
    "allow-connection-connect",
    "allow-connection-disconnect",
    "allow-sessions-list",
    "allow-metadata-children",
    "allow-object-details",
    "allow-ddl-generate",
    "allow-ddl-save",
    "allow-table-model",
    "allow-schema-preview",
    "allow-schema-apply",
    "allow-console-list",
    "allow-console-create",
    "allow-console-read",
    "allow-console-write",
    "allow-query-execute",
    "allow-query-cancel",
    "allow-history-search",
    "allow-history-delete",
    "allow-history-clear",
    "allow-history-export",
    "allow-result-page",
    "allow-result-close",
    "allow-result-export",
    "allow-result-copy",
    "allow-result-export-cancel",
    "allow-result-format",
    "allow-result-refine",
    "allow-result-preview-edits",
    "allow-result-apply-edits",
    "allow-session-state",
    "allow-session-set-tx",
    "allow-tx-commit",
    "allow-tx-rollback",
    "allow-session-close",
    "allow-session-drop",
    "allow-app-quit"
  ]
}
