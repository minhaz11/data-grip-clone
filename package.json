{
  "name": "quarry",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm -w apps/desktop run dev",
    "tauri": "npm -w apps/desktop run tauri",
    "build": "npm -w apps/desktop run build",
    "lint": "npm -w apps/desktop run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm -w apps/desktop run typecheck && tsc -p tests/e2e",
    "test": "npm -w apps/desktop run test",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:release": "node --test \"scripts/release/*.test.mjs\"",
    "bindings": "UPDATE_BINDINGS=1 cargo test -p quarry-desktop --lib bindings::"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
